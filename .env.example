# ==============================================================================
# PM Career Copilot — Environment Configuration Template
# Copy this file to '.env' and fill in your personal API keys.
# NEVER commit the actual '.env' file or OAuth credentials to version control.
# ==============================================================================

# Google Gemini API Key (used for semantic triage, structured lead parsing, and pitch personalization)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# RapidAPI Key (used by JSearch India poller for live job openings across India)
# Subscribe at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here

# Serper API Key (optional fallback for Google X-Ray decision-maker discovery)
# Obtain from: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Gmail API OAuth Setup:
# Place your Google Cloud OAuth 2.0 client secret JSON in the project root as:
#   credentials.json
# Then authenticate primary & secondary accounts via:
#   python auth_gmail_server.py --account primary
#   python auth_gmail_server.py --account secondary
